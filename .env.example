# ---------------------------------------------------------------------------
# StoryFlow AI — environment configuration
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase (required) — Project Settings → API
# The anon / publishable key is safe for browsers; data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of this deployment, used in auth email links and invite links.
# Optional locally (falls back to the request host). On Render, RENDER_EXTERNAL_URL
# is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Video worker (server-only). Keep all values out of source control.
# The worker reuses NEXT_PUBLIC_SUPABASE_URL above, plus the variables below.
#
# SUPABASE_SERVICE_ROLE_KEY — required by the video worker (worker/video-worker.mjs) only.
#   Where: Supabase dashboard → Project Settings → API Keys → `service_role` (legacy) or a
#   secret key (sb_secret_...). It BYPASSES Row Level Security, so:
#     - set it only in the worker's environment, never on the Next.js web service;
#     - never put it in a NEXT_PUBLIC_* variable or ship it to the browser;
#     - rotate it in the dashboard if it is ever exposed.
#   The Next.js web app never uses it: all web database access runs as the signed-in user
#   and is enforced by RLS. The worker needs it to claim jobs (claim_video_job is executable
#   by service_role only), update job progress, read encrypted credentials, and upload to the
#   private `storyflow-videos` Storage bucket.
SUPABASE_SERVICE_ROLE_KEY=
# Generate encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical on the web service (encrypts BYOK keys) and the worker (decrypts them).
STORYFLOW_CREDENTIALS_KEY=
AUTOMATED_VIDEO_GENERATOR_URL=http://automated-video-generator.internal:3001
AGENTIC_VIDEO_URL=http://agentic-video.internal:8787
# Put both upstream services behind private networking and an authenticated gateway.
# The web service may also set AUTOMATED_VIDEO_GENERATOR_URL + VIDEO_ENGINE_TOKEN (server-only)
# to show the engine voice list in AI Video Studio. In production the URL must use HTTPS.
VIDEO_ENGINE_TOKEN=
# Optional shared volume enables Agentic Video's analyze.video quality plugin.
AGENTIC_VIDEO_SHARED_ROOT=/var/lib/storyflow/agentic-share
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
CLAUDE_MODEL=claude-sonnet-4-5

# Google OAuth web client; redirect URI must be /api/integrations/google-drive/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Optional provider credentials (server-only, never exposed to the browser).
# Milestone 1 only detects whether these exist; no provider calls are made.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
